# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_expense?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# OIDC (Mock)
OIDC_ISSUER=http://localhost:3000
OIDC_CLIENT_ID=travel-expense-client
OIDC_CLIENT_SECRET=travel-expense-secret
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback/entra_id

# AWS / LocalStack
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=travel-expense-documents

# Email (MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@travel-expense.local

# Frontend
VITE_API_URL=http://localhost:3000
VITE_OIDC_ISSUER=http://localhost:3000
VITE_OIDC_CLIENT_ID=travel-expense-client
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback/entra_id

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173