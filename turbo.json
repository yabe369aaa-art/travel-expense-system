{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "outputs": ["coverage/**"]
    },
    "db:generate": {},
    "db:migrate": {},
    "db:push": {},
    "db:studio": {}
  },
  "globalEnv": ["DATABASE_URL", "JWT_SECRET", "NODE_ENV"]
}