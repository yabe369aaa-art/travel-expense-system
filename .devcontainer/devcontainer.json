{
  "name": "Travel Expense System",
  "dockerFile": "Dockerfile",
  "workspaceFolder": "/workspace",
  "runArgs": ["--init"],
  "mounts": [
    "source=travel-expense-node-modules,target=/workspace/node_modules,type=volume",
    "source=travel-expense-backend-node-modules,target=/workspace/packages/backend/node_modules,type=volume",
    "source=travel-expense-frontend-node-modules,target=/workspace/packages/frontend/node_modules,type=volume",
    "source=travel-expense-shared-node-modules,target=/workspace/packages/shared/node_modules,type=volume"
  ],
  "postCreateCommand": "npm ci && npm run db:generate",
  "postStartCommand": "docker-compose -f docker-compose.yml up -d",
  "forwardPorts": [3000, 5173, 5432, 4566, 8025],
  "portsAttributes": {
    "3000": { "label": "Mock OIDC", "onAutoForward": "notify" },
    "5173": { "label": "Frontend (Vite)", "onAutoForward": "notify" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "ignore" },
    "4566": { "label": "LocalStack (S3)", "onAutoForward": "ignore" },
    "8025": { "label": "MailHog UI", "onAutoForward": "notify" }
  },
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20",
      "installTools": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "vitejs.vite",
        "ms-azuretools.vscode-docker",
        "ms-vscode.vscode-typescript-next",
        "formulahendry.auto-rename-tag",
        "christian-kohler.path-intellisense",
        "usernamehw.errorlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "typescript.preferences.importModuleSpecifier": "non-relative",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}